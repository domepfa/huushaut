rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur diese Google-Konten dürfen Huushaut lesen und ändern.
    // Die beiden Adressen hier eintragen (kleingeschrieben).
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          "dome-adresse@gmail.com",
          "sarah-adresse@gmail.com"
        ];
    }

    match /household/{docId} {
      allow read, write: if isHousehold();
    }

    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
